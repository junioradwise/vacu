{
  "manifest_version": 3,
  "name": "VACU — Virtual Agentic Chrome User",
  "version": "0.4.1",
  "description": "Let VACU control Firefox HTTP(S) tabs while the local bridge is running.",
  "browser_specific_settings": { "gecko": { "id": "vacu@local.invalid", "strict_min_version": "128.0" } },
  "incognito": "not_allowed",
  "permissions": ["scripting", "nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "scripts": ["firefox/background.mjs"], "type": "module" },
  "action": { "default_title": "VACU", "default_popup": "popup.html" }
}
